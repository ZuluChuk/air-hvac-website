{
  "name": "air-hvac-website",
  "private": true,
  "scripts": {
    "build:css": "sass --no-source-map --style=compressed scss/style.scss css/style.css",
    "watch:css": "sass --watch --no-source-map scss/style.scss css/style.css",
    "build": "npm run build:css && npm run build:gallery",
    "deploy": "npm run build && wrangler deploy",
    "build:gallery": "node scripts/generate-gallery-manifest.mjs",
    "test:calculator": "node --test tests/cooling-calculator.test.cjs"
  },
  "devDependencies": {
    "sass": "^1.93.0",
    "wrangler": "^4.0.0"
  }
}
