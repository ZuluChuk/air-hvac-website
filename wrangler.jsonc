{
  "name": "air-hvac-website",
  "main": "./worker.js",
  "compatibility_date": "2026-10-24",
  "previews": {},
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "INSTAGRAM_USER_ID": "17841467051565794"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
